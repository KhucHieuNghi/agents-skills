{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:nkskills:enterprise-audit:report",
  "$comment": "Structural contract only. Use enterprise-report-validate for references, arithmetic, temporal constraints and projection integrity. Neither establishes semantic acceptance.",
  "type": "object",
  "properties": {
    "schemaFamily": {
      "const": "enterprise-report"
    },
    "schemaVersion": {
      "const": 1
    },
    "edition": {
      "const": "customer"
    },
    "revisionId": {
      "type": "string",
      "minLength": 1
    },
    "parentReportDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "authorId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRunDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "const": "enterprise-report"
        },
        "version": {
          "const": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "sourceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["name", "version", "node", "sourceDigest"],
      "additionalProperties": false
    },
    "brand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "accent": {
          "type": "string",
          "pattern": "^#[a-fA-F0-9]{6}$"
        }
      },
      "required": ["name", "accent"],
      "additionalProperties": false
    },
    "assessment": {
      "$ref": "urn:nkskills:enterprise-audit:run"
    },
    "coverage": {
      "type": "object",
      "properties": {
        "modules": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "applicable": {
                "type": "integer",
                "minimum": 0
              },
              "passed": {
                "type": "integer",
                "minimum": 0
              },
              "failed": {
                "type": "integer",
                "minimum": 0
              },
              "unknown": {
                "type": "integer",
                "minimum": 0
              },
              "notApplicable": {
                "type": "integer",
                "minimum": 0
              },
              "assessmentCoverage": {
                "type": ["number", "null"],
                "minimum": 0,
                "maximum": 1
              },
              "status": {
                "enum": ["unplanned", "partial", "assessed"]
              }
            },
            "required": [
              "total",
              "applicable",
              "passed",
              "failed",
              "unknown",
              "notApplicable",
              "assessmentCoverage",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "reportComplete": {
          "type": "boolean"
        }
      },
      "required": ["modules", "reportComplete"],
      "additionalProperties": false
    },
    "dataRequests": {
      "type": "array",
      "items": {
        "$ref": "urn:nkskills:enterprise-audit:data-request"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "findingId": {
            "type": "string",
            "minLength": 1
          },
          "checkId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "businessImpact": {
            "type": "string",
            "minLength": 1
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "severity": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "confidence": {
            "enum": ["high", "medium", "low"]
          }
        },
        "required": [
          "findingId",
          "checkId",
          "title",
          "description",
          "businessImpact",
          "recommendation",
          "verification",
          "evidenceIds",
          "severity",
          "confidence"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actionId": {
            "type": "string",
            "minLength": 1
          },
          "ownerRole": {
            "type": "string",
            "minLength": 1
          },
          "effort": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "verification": {
            "type": "string",
            "minLength": 1
          },
          "findingIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "const": "proposed"
          }
        },
        "required": [
          "actionId",
          "ownerRole",
          "effort",
          "description",
          "verification",
          "findingIds",
          "dependencies",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observationId": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "scopeDescription": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": ["historical", "current"]
          },
          "precision": {
            "enum": ["exact", "approximate", "range", "unknown"]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "period": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "format": "date"
              },
              "to": {
                "type": "string",
                "format": "date"
              }
            },
            "required": ["from", "to"],
            "additionalProperties": false
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                },
                "required": ["min", "max"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "numerator": {
                    "type": "number"
                  },
                  "denominator": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                },
                "required": ["numerator", "denominator"],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "observationId",
          "label",
          "unit",
          "scopeDescription",
          "classification",
          "precision",
          "evidenceIds",
          "period",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "narrative": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "narrativeId": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "observation",
              "interpretation",
              "recommendation",
              "limitation"
            ]
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": ["narrativeId", "text", "kind", "evidenceIds"],
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetId": {
            "type": "string",
            "minLength": 1
          },
          "reviewerId": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "targetType": {
            "enum": ["check", "finding", "action", "observation", "narrative"]
          },
          "targetDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "reviewerType": {
            "enum": ["human", "independent-ai"]
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time"
          },
          "verdict": {
            "enum": ["accept", "revise", "reject"]
          }
        },
        "required": [
          "targetId",
          "reviewerId",
          "reason",
          "targetType",
          "targetDigest",
          "reviewerType",
          "reviewedAt",
          "verdict"
        ],
        "additionalProperties": false
      }
    },
    "redaction": {
      "type": "object",
      "properties": {
        "policyDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "method": {
          "const": "literal-and-common-patterns"
        },
        "reviewRequired": {
          "const": true
        }
      },
      "required": ["policyDigest", "method", "reviewRequired"],
      "additionalProperties": false
    },
    "methodology": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "assessedChecks": {
          "type": "integer",
          "minimum": 0
        },
        "unknownChecks": {
          "type": "integer",
          "minimum": 0
        },
        "failedChecks": {
          "type": "integer",
          "minimum": 0
        },
        "notApplicableChecks": {
          "type": "integer",
          "minimum": 0
        },
        "applicableChecks": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "untriagedFailedChecks": {
          "type": "integer",
          "minimum": 0
        },
        "historicalObservations": {
          "type": "integer",
          "minimum": 0
        },
        "currentObservations": {
          "type": "integer",
          "minimum": 0
        },
        "reviewTargets": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedReviewTargets": {
          "type": "integer",
          "minimum": 0
        },
        "reportComplete": {
          "type": "boolean"
        },
        "assessmentCoverage": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "siteHealth": {
          "enum": [
            "failed-checks-observed",
            "undetermined",
            "no-failed-checks-in-declared-scope"
          ]
        },
        "implementationStatus": {
          "enum": ["proposed", "not-started"]
        },
        "reviewStatus": {
          "enum": ["pending", "reviewed"]
        }
      },
      "required": [
        "assessedChecks",
        "unknownChecks",
        "failedChecks",
        "notApplicableChecks",
        "applicableChecks",
        "findings",
        "untriagedFailedChecks",
        "historicalObservations",
        "currentObservations",
        "reviewTargets",
        "acceptedReviewTargets",
        "reportComplete",
        "assessmentCoverage",
        "siteHealth",
        "implementationStatus",
        "reviewStatus"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaFamily",
    "schemaVersion",
    "edition",
    "revisionId",
    "parentReportDigest",
    "generatedAt",
    "authorId",
    "sourceRunDigest",
    "tool",
    "brand",
    "assessment",
    "coverage",
    "dataRequests",
    "findings",
    "actions",
    "observations",
    "narrative",
    "decisions",
    "redaction",
    "methodology",
    "summary"
  ],
  "additionalProperties": false
}
