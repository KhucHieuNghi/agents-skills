{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:nkskills:content-search-audit:common",
  "title": "Content Search Audit common",
  "$comment": "Offline structural contract. Runtime integrity, rule semantics and cross-record checks remain mandatory.",
  "definitions": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "strings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "dimension": {
      "enum": ["quality", "seo", "aio", "aeo", "geo", "portfolio"]
    },
    "state": {
      "enum": [
        "pending",
        "audited",
        "failed",
        "blocked",
        "unsupported",
        "excluded"
      ]
    },
    "status": {
      "enum": ["pass", "fail", "unknown", "not-applicable"]
    },
    "artifactPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]+:)(?!.*[\\\\\\u0000])(?!(?:.*\\/)?\\.{1,2}(?:\\/|$))[^/]+(?:/[^/]+)*$"
    }
  }
}
