---
import "../styles/global.css";
import "@fontsource/be-vietnam-pro/400.css";
import "@fontsource/be-vietnam-pro/600.css";
import "@fontsource/be-vietnam-pro/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import { seoLinks, type PageKind } from "../lib/routes.js";

interface Props {
  locale: "en" | "vi";
  title: string;
  description: string;
  pageKind?: PageKind;
  alternatePath?: string;
}

const { locale, title, description, pageKind, alternatePath } = Astro.props;
const isVietnamese = locale === "vi";
const home = isVietnamese ? "/vi/" : "/en/";
const catalog = isVietnamese ? "/vi/catalog/" : "/en/catalog/";
const solutionsLink = pageKind === "home" ? "#solutions" : `${catalog}#solutions`;
const otherLocale = isVietnamese ? "en" : "vi";
const otherPath = alternatePath ?? `/${otherLocale}/`;
const seo = pageKind ? seoLinks(pageKind, locale, process.env.SITE_MODE, process.env.SITE_ORIGIN) : null;
const image = seo ? `${new URL(seo.canonical).origin}/brand/og-${locale}.png` : `/brand/og-${locale}.png`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="description" content={description} />
    {seo ? null : <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    {seo && <link rel="canonical" href={seo.canonical} />}
    {seo && Object.entries(seo.alternates).map(([language, href]) => <link rel="alternate" hreflang={language} href={href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    {seo && <meta property="og:url" content={seo.canonical} />}
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class={pageKind === "home" ? "home-page" : undefined}>
    <a class="skip-link" href="#main-content">{isVietnamese ? "Đến nội dung chính" : "Skip to content"}</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={home} aria-label="NKSkills home">
          <img src="/brand/nkskills-mark.svg" width="42" height="42" alt="" />
          <span>NK<span>Skills</span></span>
        </a>
        <nav class="site-nav" aria-label={isVietnamese ? "Điều hướng chính" : "Main navigation"}>
          <a class="nav-optional" href={solutionsLink}>{isVietnamese ? "Giải pháp" : "Solutions"}</a>
          <a class="nav-optional nav-catalog" href={catalog}>{isVietnamese ? "Danh mục" : "Catalog"}</a>
          <a href={`${home}#try-it`}>{isVietnamese ? "Dùng thử" : "Try it"}</a>
          <a class="language-link" href={otherPath} lang={otherLocale} aria-label={isVietnamese ? "Switch to English" : "Chuyển sang tiếng Việt"}>{isVietnamese ? "EN" : "VI"}</a>
        </nav>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong>NKSkills</strong><br />
          {isVietnamese ? "Skill workflow có phiên bản cho Codex và Claude Code." : "Versioned skill workflows for Codex and Claude Code."}
        </div>
        <div class="footer-links">
          <a href={catalog}>{isVietnamese ? "Danh mục" : "Catalog"}</a>
          <a href={solutionsLink}>{isVietnamese ? "Giải pháp" : "Solutions"}</a>
          <a href="https://github.com/KhucHieuNghi/agents-skills">GitHub</a>
          <a href="https://github.com/KhucHieuNghi/agents-skills/blob/main/docs/releases/1.1.0.md">{isVietnamese ? "Bản phát hành" : "Release record"}</a>
          <a href="/licenses/README.txt">{isVietnamese ? "Giấy phép font" : "Font licenses"}</a>
          <a href={otherPath} lang={otherLocale}>{isVietnamese ? "English" : "Tiếng Việt"}</a>
        </div>
      </div>
    </footer>
  </body>
</html>
