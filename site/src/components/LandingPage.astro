---
import Base from "../layouts/Base.astro";
import PromptPicker from "./PromptPicker.astro";
import WorkflowDiagram from "./WorkflowDiagram.astro";
import { metadata } from "../content/copy.js";
import { productFacts } from "../content/product.js";
import { routePair, type Locale } from "../lib/routes.js";
import "../styles/landing.css";

interface Props { locale: Locale }
const { locale } = Astro.props;
const vi = locale === "vi";
const copy = metadata[locale].home;
const solution = routePair("solution")[locale];
const catalog = routePair("catalog")[locale];
const codex = routePair("codex-guide")[locale];
const claude = routePair("claude-guide")[locale];
const alternatePath = routePair("home")[vi ? "en" : "vi"];
---

<Base locale={locale} pageKind="home" title={copy.title} description={copy.description} alternatePath={alternatePath}>
  <section class="landing-hero"><div class="container hero-grid">
    <div class="hero-copy"><p class="hero-kicker"><span class="live-dot"></span> NKSKILLS / {vi ? "SKILL WORKFLOW CÓ PHIÊN BẢN" : "VERSIONED SKILL WORKFLOWS"}</p><h1>{copy.heading}</h1><p class="hero-lead">{vi ? "Kết hợp skill gốc và skill công khai thành một quy trình có đầu ra, phiên bản và nguồn gốc kiểm tra được. Bắt đầu với hành trình hiểu codebase cho kỹ sư." : "Combine original and public skills into a workflow with a defined output, version, and traceable sources. Start with codebase onboarding for engineers."}</p><div class="hero-actions"><a class="button" href="#try-it">{vi ? "Lấy prompt dùng thử" : "Get the starter prompt"}<span aria-hidden="true">↗</span></a><a class="button button-secondary" href={catalog}>{vi ? "Khám phá danh mục" : "Explore the catalog"}</a></div><div class="hero-meta"><span>{vi ? "Dành cho" : "Built for"} <strong>Codex + Claude Code</strong></span><span>{vi ? "Bản kỹ thuật" : "Technical release"} <strong>1.1.0</strong></span></div></div>
    <div class="composition" aria-label={vi ? "Sơ đồ thành phần codebase onboarding" : "Codebase onboarding composition"}><div class="composition-top"><span>NK / 001</span><span>COMPOSITION LOCK</span></div><div class="composition-heading"><span class="composition-state">● {vi ? "BẢN KỸ THUẬT" : "TECHNICAL RELEASE"}</span><h2>codebase<br/>onboarding</h2><span class="composition-version">@1.1.0</span></div><div class="composition-rule"></div><div class="composition-rows"><div><span>01</span><strong>codebase-onboarding-c4</strong><small>{vi ? "workflow gốc" : "original workflow"}</small></div><div><span>02</span><strong>html-docs-standard</strong><small>{vi ? "tài liệu gốc" : "original docs"}</small></div><div><span>03</span><strong>hallmark</strong><small>{vi ? "upstream đã khóa" : "pinned upstream"}</small></div></div><div class="composition-output"><span>{vi ? "ĐẦU RA" : "OUTPUT"}</span><strong>{vi ? "Hành trình sản phẩm · C1/C2 · Dẫn chứng theo file" : "Product journey · C1/C2 · File evidence"}</strong></div></div>
  </div><div class="hero-bottom container"><span>{vi ? "01 SẢN PHẨM KỸ THUẬT ĐÃ PHÁT HÀNH" : "01 TECHNICAL PRODUCT RELEASE"}</span><span>{vi ? "02 MÔI TRƯỜNG ĐƯỢC HỖ TRỢ" : "02 SUPPORTED HOSTS"}</span><a href={productFacts.links.release}>{vi ? "XEM BẰNG CHỨNG PHÁT HÀNH" : "READ THE RELEASE RECORD"} ↗</a></div></section>

  <section class="landing-section intro-section container" id="how-it-works"><div class="section-aside"><span>01 / {vi ? "Ý TƯỞNG" : "THE IDEA"}</span><p>{vi ? "Một lớp sản phẩm trên các skill riêng lẻ" : "A product layer over individual skills"}</p></div><div class="section-main"><h2>{vi ? "Skill rời rạc có năng lực. Một Solution Skill có trách nhiệm về kết quả." : "Individual skills bring capability. A Solution Skill owns the outcome."}</h2><p class="section-lead">{vi ? "NKSkills chọn skill công khai phù hợp, ghi lại commit và giấy phép, rồi kết hợp với quy trình do chúng tôi xây dựng. Mỗi combo có manifest, điều kiện chạy, đầu ra và phiên bản riêng." : "NKSkills selects public skills, records their commits and licenses, and composes them with original workflows. Each combo has its own manifest, prerequisites, output, and version."}</p><div class="model-pair"><div><span>UPSTREAM SKILL</span><h3>{vi ? "Năng lực đã chọn" : "Selected capability"}</h3><p>{vi ? "Nguồn công khai, giấy phép, commit và thay đổi cục bộ được theo dõi." : "Public source, license, commit, and local changes are tracked."}</p></div><div><span>SOLUTION SKILL</span><h3>{vi ? "Quy trình có đầu ra" : "Outcome-driven workflow"}</h3><p>{vi ? "Thứ tự thực hiện, điều kiện, thành phần và tiêu chuẩn kiểm tra được đóng phiên bản." : "Sequence, prerequisites, components, and verification criteria are versioned."}</p></div></div><a class="inline-link" href={catalog}>{vi ? "Xem toàn bộ danh mục" : "Explore the full catalog"} <span>↗</span></a></div></section>

  <section class="featured-section" id="solutions"><div class="container"><div class="featured-head"><div><p class="eyebrow">02 / SOLUTION SKILLS</p><h2>{vi ? "Hiểu hệ thống. Trình bày vấn đề." : "Understand the system. Present the problem."}</h2></div><p>{vi ? "Hai workflow có đầu ra riêng: một giúp kỹ sư làm rõ codebase; một giúp nhóm trình bày vấn đề và quyết định cần đưa ra." : "Two workflows with distinct outcomes: one maps an unfamiliar codebase; the other helps a team present a problem and the decision ahead."}</p></div><div class="featured-grid"><div class="featured-product"><div class="product-top"><span>NK / SOLUTION 001</span><span>v1.1.0</span></div><h3>Codebase<br/>onboarding</h3><p>{vi ? "Một hành trình sản phẩm, các ranh giới C1/C2 và đường dẫn file để kiểm chứng nhận định." : "One product journey, C1/C2 boundaries, and file paths that make each claim reviewable."}</p><div class="product-footer"><span>{vi ? "BẢN PHÁT HÀNH KỸ THUẬT" : "TECHNICAL RELEASE"}</span><a href={solution}>{vi ? "Xem giải pháp" : "Explore solution"} ↗</a></div></div><div class="featured-detail"><span class="detail-label">{vi ? "BẠN NHẬN ĐƯỢC" : "WHAT YOU GET"}</span><div><strong>01</strong><p>{vi ? "Bản đồ hành trình chính: người dùng, điểm vào, luồng gọi và dữ liệu liên quan." : "A primary journey map: actors, entry points, call path, and related data."}</p></div><div><strong>02</strong><p>{vi ? "Sơ đồ C1/C2 để giải thích phạm vi hệ thống và các thành phần quan trọng." : "C1/C2 views of system scope and the important components."}</p></div><div><strong>03</strong><p>{vi ? "Dẫn chứng theo file, phần còn suy luận và những điểm cần người sở hữu xác nhận." : "File-level evidence, remaining inferences, and questions for the system owner."}</p></div><a href={productFacts.links.release}>{vi ? "Đọc biên bản phát hành" : "Read the release record"} ↗</a></div></div><p class="release-note">{vi ? "Giới hạn hiện tại: bản 1.1.0 đã qua kiểm tra build và cài đặt; chất lượng hành vi trên nhiều codebase khách hàng chưa được xác minh rộng rãi." : "Current limit: version 1.1.0 has build and install checks; behavior quality across customer repositories is not broadly verified yet."}</p><article class="featured-candidate"><div class="candidate-top"><span>NK / SOLUTION 002</span><span>v0.1.0</span></div><div class="candidate-content"><div><p class="candidate-status">{vi ? "ỨNG VIÊN ĐÁNH GIÁ" : "EVALUATION CANDIDATE"}</p><h3>Problem presentation</h3></div><p>{vi ? "Biến một vấn đề có dẫn chứng thành deck HTML dùng ngoại tuyến và bản PDF tương ứng, với nguồn và nhận diện thương hiệu có thể kiểm tra. Chưa qua cổng phát hành thương mại." : "Turn one evidenced problem into an offline HTML deck and matching PDF, with traceable sources and brand identity. The commercial release gate remains open."}</p></div><div class="candidate-footer"><span>Codex · Claude Code</span><a href="https://github.com/KhucHieuNghi/agents-skills/blob/main/solutions/problem-presentation.yaml">{vi ? "Xem manifest" : "View manifest"} ↗</a></div></article></div></section>

  <section class="landing-section prompt-section container" id="try-it"><div class="section-heading"><div><p class="eyebrow">03 / {vi ? "DÙNG THỬ" : "TRY IT"}</p><h2>{vi ? "Bắt đầu bằng một prompt." : "Start with one prompt."}</h2></div><p>{vi ? "Chọn môi trường và ngôn ngữ, xem nội dung rồi sao chép. Cài skill từ GitHub và chuẩn bị CodeGraph trước khi chạy." : "Select your host and language, review the prompt, then copy. Install the skill from GitHub and prepare CodeGraph before running it."}</p></div><PromptPicker locale={locale} /><div class="setup-links"><strong>{vi ? "Cần cài đặt trước?" : "Need to set up first?"}</strong><a href={codex}>{vi ? "Hướng dẫn Codex" : "Codex guide"} ↗</a><a href={claude}>{vi ? "Hướng dẫn Claude Code" : "Claude Code guide"} ↗</a></div></section>

  <section class="process-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">04 / {vi ? "TRONG THỰC TẾ" : "IN PRACTICE"}</p><h2>{vi ? "Từ repository đến hiểu biết có thể kiểm tra." : "From repository to reviewable understanding."}</h2></div><p>{vi ? "Workflow đặt điều kiện rõ ràng trước khi phân tích và để lộ những điểm còn chưa chắc chắn." : "The workflow checks prerequisites before analysis and makes uncertainty visible."}</p></div><div class="process-grid"><article><span>01 / {vi ? "CHUẨN BỊ" : "PREPARE"}</span><h3>{vi ? "Cài và kiểm tra" : "Install and verify"}</h3><p>{vi ? "Build từ GitHub, kiểm tra digest, có codegraph, rtk và index hợp lệ ở root." : "Build from GitHub, verify the digest, and prepare codegraph, rtk, and a valid root index."}</p></article><article><span>02 / {vi ? "TRUY VẾT" : "TRACE"}</span><h3>{vi ? "Theo một hành trình" : "Follow one journey"}</h3><p>{vi ? "Đi từ entry point qua logic và dữ liệu thật; phân biệt bằng chứng với suy luận." : "Follow an entry point through real logic and data; distinguish evidence from inference."}</p></article><article><span>03 / {vi ? "ĐÁNH GIÁ" : "REVIEW"}</span><h3>{vi ? "Kiểm chứng đầu ra" : "Review the output"}</h3><p>{vi ? "Xem sơ đồ, dẫn chứng và câu hỏi mở trước khi dùng kết quả để ra quyết định." : "Review diagrams, citations, and open questions before relying on the output."}</p></article></div><WorkflowDiagram locale={locale} /></div></section>

  <section class="landing-section catalog-preview container"><div><p class="eyebrow">05 / {vi ? "DANH MỤ" : "CATALOG"}</p><h2>{vi ? "Một bộ sưu tập có nguồn gốc." : "A collection with provenance."}</h2><p>{vi ? "Các skill công khai được chọn theo mục đích, theo dõi phiên bản và giấy phép. Khi upstream thay đổi, phiên bản mới là ứng viên để đánh giá; sản phẩm đang phát hành không tự đổi theo." : "Public skills are selected for a purpose, with versions and licenses tracked. An upstream change becomes a review candidate; an existing release does not change automatically."}</p><a class="button button-secondary" href={catalog}>{vi ? "Khám phá danh mục" : "Browse the catalog"} ↗</a></div><div class="catalog-preview-list"><div><span>UPSTREAM / DESIGN</span><strong>hallmark</strong><small>{vi ? "Trong codebase onboarding" : "In codebase onboarding"}</small></div><div><span>UPSTREAM / DIAGRAMS</span><strong>diagram-design</strong><small>{vi ? "Trong ứng viên problem presentation" : "In problem presentation candidate"}</small></div><div><span>UPSTREAM / AUTHORING</span><strong>frontend-design + copywriting</strong><small>{vi ? "Dùng xây dựng website này" : "Used to build this site"}</small></div><div><span>+</span><strong>{vi ? "Xem toàn bộ nguồn và commit" : "See every source and commit"}</strong><a href={catalog}>↗</a></div></div></section>

  <section class="faq-section landing-section container"><div><p class="eyebrow">06 / FAQ</p><h2>{vi ? "Những điều cần biết." : "Good to know."}</h2></div><div class="faq-list"><details><summary>{vi ? "NKSkills có hỗ trợ môi trường nào?" : "Which hosts are supported?"}</summary><p>{vi ? "Codex và Claude Code. Hai hướng dẫn cài đặt riêng giải thích cách sử dụng codebase-onboarding trên từng môi trường." : "Codex and Claude Code. Each has its own setup guide for codebase-onboarding."}</p></details><details><summary>{vi ? "Upstream mới có tự cập nhật vào Solution Skill không?" : "Do upstream updates change a Solution Skill automatically?"}</summary><p>{vi ? "Không. Chúng tôi theo dõi nguồn, kiểm tra bản mới rồi mới quyết định có phát hành phiên bản Solution Skill mới hay không." : "No. We track sources, review new versions, then decide whether to issue a new Solution Skill release."}</p></details><details><summary>{vi ? "Tôi có thể dùng trên project bất kỳ không?" : "Can I use it on any project?"}</summary><p>{vi ? "Bản 1.1.0 đã được kiểm tra build và cài đặt, nhưng chất lượng hành vi trên từng repository chưa được xác minh rộng rãi. Hãy kiểm tra kết quả trước khi dùng để ra quyết định." : "Version 1.1.0 has build and install checks, but behavior quality across repositories is not broadly verified. Review its output before making decisions."}</p></details><details><summary>{vi ? "Skill được cài như thế nào?" : "How do I install the skill?"}</summary><p>{vi ? "Hiện tại build từ mã nguồn GitHub và làm theo hướng dẫn kỹ thuật để kiểm tra digest, rồi cài vào Codex hoặc Claude Code. Chưa có archive tải trực tiếp." : "Build from GitHub source, verify the digest with the technical guide, then install in Codex or Claude Code. A direct-download archive is not published yet."}</p></details><details><summary>{vi ? "Prompt có tự sửa code của tôi không?" : "Will the prompt change my code?"}</summary><p>{vi ? "Prompt yêu cầu báo cáo trong chat trước và hỏi trước khi truy cập hệ thống ngoài hoặc ghi artifact. Nếu thiếu điều kiện chạy, AI phải dừng trước khi cài công cụ, tạo index hoặc sửa file." : "The prompt asks for findings in chat first and approval before external access or artifact writes. If prerequisites are missing, the AI must stop before installing tools, indexing, or editing files."}</p></details></div></section>

  <section class="closing-cta"><div class="container"><p class="eyebrow">NKSKILLS / CODEBASE ONBOARDING</p><h2>{vi ? "Hiểu hệ thống trước khi thay đổi nó." : "Understand the system before you change it."}</h2><div><a class="button" href="#try-it">{vi ? "Sao chép prompt dùng thử" : "Copy the starter prompt"} ↗</a><a class="closing-link" href={solution}>{vi ? "Xem giải pháp" : "Explore solution"} ↗</a></div></div></section>
</Base>
