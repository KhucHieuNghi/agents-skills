---
import Base from "../layouts/Base.astro";
import PromptPicker from "./PromptPicker.astro";
import WorkflowDiagram from "./WorkflowDiagram.astro";
import { metadata } from "../content/copy.js";
import { productFacts } from "../content/product.js";
import { routePair, type Locale } from "../lib/routes.js";
import "../styles/landing.css";

interface Props { locale: Locale }
const { locale } = Astro.props;
const vi = locale === "vi";
const copy = metadata[locale].home;
const solution = routePair("solution")[locale];
const catalog = routePair("catalog")[locale];
const codex = routePair("codex-guide")[locale];
const claude = routePair("claude-guide")[locale];
const alternatePath = routePair("home")[vi ? "en" : "vi"];
const presentationManifest = "https://github.com/KhucHieuNghi/agents-skills/blob/main/solutions/problem-presentation.yaml";
---

<Base locale={locale} pageKind="home" title={copy.title} description={copy.description} alternatePath={alternatePath}>
  <div class="nks-landing">
    <section class="hero-stage" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">NKSKILLS / SOLUTION SKILLS</p>
          <h1 id="hero-title">{vi ? "Nhiều skills." : "Many skills."}<br /><span>{vi ? "Một kết quả rõ ràng." : "One clear outcome."}</span></h1>
          <p class="hero-description">{vi ? "Chúng tôi chọn skill công khai, khóa phiên bản và kết hợp với workflow gốc để Codex hoặc Claude Code hoàn thành một công việc cụ thể." : "We select public skills, pin their versions, and combine them with original workflows so Codex or Claude Code can complete a specific job."}</p>
          <div class="hero-actions">
            <a class="button hero-primary" href="#try-it">{vi ? "Lấy prompt dùng thử" : "Get the starter prompt"} <span aria-hidden="true">↗</span></a>
            <a class="hero-secondary" href="#solutions">{vi ? "Xem Solution Skills" : "Explore Solution Skills"} <span aria-hidden="true">↗</span></a>
          </div>
          <p class="hero-support">Codex <span aria-hidden="true">/</span> Claude Code <span aria-hidden="true">·</span> {vi ? "Nguồn và phiên bản có thể truy vết" : "Traceable sources and versions"}</p>
        </div>
        <div class="composition-panel" aria-label={vi ? "Thành phần của codebase onboarding" : "Codebase onboarding components"}>
          <div class="panel-topline"><span>{vi ? "VÍ DỤ THỰC TẾ" : "A REAL COMPOSITION"}</span><span>01 / 02</span></div>
          <p class="panel-intro">{vi ? "Ba thành phần, một đầu ra." : "Three components, one outcome."}</p>
          <div class="component-list">
            <div class="component-row"><span class="component-number">01</span><div><strong>hallmark</strong><small>{vi ? "Upstream Skill · khóa revision" : "Upstream Skill · revision pinned"}</small></div></div>
            <div class="component-row"><span class="component-number">02</span><div><strong>codebase-onboarding-c4</strong><small>{vi ? "Workflow gốc" : "Original workflow"}</small></div></div>
            <div class="component-row"><span class="component-number">03</span><div><strong>html-docs-standard</strong><small>{vi ? "Chuẩn tài liệu gốc" : "Original document standard"}</small></div></div>
          </div>
          <div class="composition-result"><span>{vi ? "SOLUTION SKILL / 1.1.0" : "SOLUTION SKILL / 1.1.0"}</span><strong>codebase-onboarding</strong><small>{vi ? "Hành trình sản phẩm · C1/C2 · dẫn chứng theo file" : "Product journey · C1/C2 · file evidence"}</small></div>
        </div>
      </div>
    </section>

    <div class="release-line container">
      <p><strong>{vi ? "Hiện có 2 Solution Skills." : "2 Solution Skills in the catalog."}</strong> {vi ? "Một bản phát hành kỹ thuật và một ứng viên đánh giá." : "One technical release and one evaluation candidate."}</p>
      <a href={productFacts.links.release}>{vi ? "Xem biên bản phát hành" : "Read the release record"} <span aria-hidden="true">↗</span></a>
    </div>

    <section class="solutions-section container" id="solutions" aria-labelledby="solutions-title">
      <div class="section-heading">
        <div><p class="eyebrow">SOLUTION SKILLS</p><h2 id="solutions-title">{vi ? "Chọn theo kết quả cần làm." : "Choose by the work to be done."}</h2></div>
        <p>{vi ? "Mỗi workflow có phiên bản, thành phần và mức xác minh riêng. Trạng thái dưới đây dựa trên bằng chứng hiện có." : "Each workflow has its own version, components, and verification status. These labels reflect the evidence we have today."}</p>
      </div>
      <div class="solution-list">
        <article class="work-card work-card-primary">
          <div class="work-index"><span>01</span><span class="work-status">{vi ? "BẢN PHÁT HÀNH KỸ THUẬT" : "TECHNICAL RELEASE"}</span><span class="work-version">v1.1.0</span></div>
          <div class="work-main"><div><h3>Codebase onboarding</h3><p>{vi ? "Hiểu một repository lạ qua hành trình sản phẩm, kiến trúc C1/C2 và dẫn chứng theo file trước khi sửa mã." : "Understand an unfamiliar repository through its product journey, C1/C2 architecture, and file evidence before editing code."}</p><p class="work-note">{vi ? "Đã kiểm tra build và cài đặt; chất lượng hành vi trên nhiều codebase khách hàng chưa được xác minh rộng rãi." : "Build and installation checked; behavior across customer repositories is not broadly verified yet."}</p></div><div class="work-links"><a class="text-link" href={solution}>{vi ? "Xem workflow" : "Explore workflow"} ↗</a><a href={productFacts.links.release}>{vi ? "Biên bản phát hành" : "Release record"}</a></div></div>
        </article>
        <article class="work-card work-card-candidate">
          <div class="work-index"><span>02</span><span class="work-status">{vi ? "ỨNG VIÊN ĐÁNH GIÁ" : "EVALUATION CANDIDATE"}</span><span class="work-version">v0.1.0</span></div>
          <div class="work-main"><div><h3>Problem presentation</h3><p>{vi ? "Biến một vấn đề có dẫn chứng thành deck HTML ngoại tuyến và PDF tương ứng, có nguồn và nhận diện thương hiệu rõ ràng." : "Turn one evidenced problem into an offline HTML deck and matching PDF, with traceable sources and brand identity."}</p><p class="work-note">{vi ? "Chưa qua cổng phát hành thương mại." : "The commercial release gate remains open."}</p></div><div class="work-links"><a class="text-link" href={catalog + "#solutions"}>{vi ? "Xem trong danh mục" : "View in catalog"} ↗</a><a href={presentationManifest}>{vi ? "Xem manifest" : "View manifest"}</a></div></div>
        </article>
      </div>
    </section>

    <section class="method-section" aria-labelledby="method-title"><div class="container method-grid">
      <div class="method-intro"><p class="eyebrow">{vi ? "CÁCH NKSKILLS HOẠT ĐỘNG" : "HOW NKSKILLS WORKS"}</p><h2 id="method-title">{vi ? "Nguồn rõ ràng. Quy trình có chủ đích." : "Trace the source. Design the workflow."}</h2><p>{vi ? "Một upstream có bản mới sẽ được đưa vào diện xem xét, không tự thay đổi Solution Skill đã phát hành." : "A new upstream revision becomes a review candidate; it does not silently change a released Solution Skill."}</p><a class="text-link" href={catalog}>{vi ? "Xem catalog và nguồn" : "Explore the catalog and sources"} ↗</a></div>
      <ol class="method-steps"><li><span>01</span><div><h3>{vi ? "Chọn và ghi nguồn" : "Select and record"}</h3><p>{vi ? "Ghi repository, commit, giấy phép và thay đổi cục bộ của từng public skill." : "Record each public skill's repository, commit, license, and local changes."}</p></div></li><li><span>02</span><div><h3>{vi ? "Ghép thành workflow" : "Compose the workflow"}</h3><p>{vi ? "Workflow gốc xác định thứ tự, điều kiện chạy và đầu ra cho công việc cụ thể." : "The original workflow defines sequence, prerequisites, and the output for a specific job."}</p></div></li><li><span>03</span><div><h3>{vi ? "Kiểm tra rồi phát hành" : "Verify and release"}</h3><p>{vi ? "Mỗi Solution Skill có phiên bản, manifest và giới hạn xác minh riêng." : "Each Solution Skill gets its own version, manifest, and verification limits."}</p></div></li></ol>
      <div class="method-diagram"><WorkflowDiagram locale={locale} /></div>
    </div></section>

    <section class="try-section container" id="try-it" aria-labelledby="try-title">
      <div class="section-heading"><div><p class="eyebrow">{vi ? "DÙNG THỬ" : "TRY IT"}</p><h2 id="try-title">{vi ? "Bắt đầu với codebase onboarding." : "Start with codebase onboarding."}</h2></div><p>{vi ? "Chọn Codex hoặc Claude Code, đọc prompt rồi sao chép. Cài skill từ GitHub và chuẩn bị CodeGraph trước khi chạy." : "Choose Codex or Claude Code, review the prompt, then copy it. Install the skill from GitHub and prepare CodeGraph before running it."}</p></div>
      <PromptPicker locale={locale} />
      <div class="setup-links"><strong>{vi ? "Hướng dẫn cài đặt" : "Setup guides"}</strong><a href={codex}>Codex ↗</a><a href={claude}>Claude Code ↗</a></div>
    </section>

    <section class="faq-section container" aria-labelledby="faq-title"><div><p class="eyebrow">FAQ</p><h2 id="faq-title">{vi ? "Trước khi bắt đầu" : "Before you begin"}</h2></div><div class="faq-list">
      <details><summary>{vi ? "NKSkills hỗ trợ môi trường nào?" : "Which hosts are supported?"}</summary><p>{vi ? "Codex và Claude Code. Mỗi môi trường có hướng dẫn cài đặt riêng." : "Codex and Claude Code. Each host has its own installation guide."}</p></details>
      <details><summary>{vi ? "Upstream mới có tự cập nhật vào Solution Skill không?" : "Do upstream updates change a Solution Skill automatically?"}</summary><p>{vi ? "Không. Chúng tôi theo dõi nguồn, kiểm tra bản mới rồi mới quyết định có phát hành phiên bản Solution Skill mới hay không." : "No. We track sources, review new versions, then decide whether to issue a new Solution Skill release."}</p></details>
      <details><summary>{vi ? "Problem presentation đã sẵn sàng thương mại chưa?" : "Is problem presentation commercially ready?"}</summary><p>{vi ? "Chưa. Bản 0.1.0 là ứng viên đánh giá; cổng phát hành thương mại vẫn mở." : "No. Version 0.1.0 is an evaluation candidate, and the commercial release gate remains open."}</p></details>
      <details><summary>{vi ? "Prompt có tự sửa code của tôi không?" : "Will the prompt change my code?"}</summary><p>{vi ? "Prompt yêu cầu báo cáo trong chat trước và hỏi trước khi truy cập hệ thống ngoài hoặc ghi artifact. Nếu thiếu điều kiện chạy, AI phải dừng trước khi cài công cụ, tạo index hoặc sửa file." : "The prompt asks for findings in chat first and approval before external access or artifact writes. If prerequisites are missing, the AI must stop before installing tools, indexing, or editing files."}</p></details>
    </div></section>
  </div>
</Base>
