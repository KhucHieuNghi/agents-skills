---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { parse } from "yaml";
import Base from "../layouts/Base.astro";
import { metadata } from "../content/copy.js";
import { routePair, type Locale } from "../lib/routes.js";
import "../styles/catalog.css";

interface Props { locale: Locale }
const { locale } = Astro.props;
const vi = locale === "vi";
const copy = metadata[locale].catalog;
type Upstream = { repository: string; revision: string; skillPath: string; license: string; topics: string[] };
const catalog = parse(readFileSync(resolve(process.cwd(), "../catalog.yaml"), "utf8")) as { upstreams: Record<string, Upstream> };
const upstreams = Object.entries(catalog.upstreams).map(([id, upstream]) => ({ id, ...upstream }));
const authoring = new Set(["frontend-design", "copywriting"]);
const solution = routePair("solution")[locale];
---

<Base locale={locale} pageKind="catalog" title={copy.title} description={copy.description} alternatePath={routePair("catalog")[vi ? "en" : "vi"]}>
  <div class="catalog-hero">
    <div class="container">
      <p class="eyebrow">NKSKILLS / {vi ? "DANH MỤ" : "CATALOG"}</p>
      <h1>{copy.heading}</h1>
      <p>{vi ? "Hai lớp tạo nên NKSkills: Solution Skill quy định kết quả và các bước thực hiện; Upstream Skill cung cấp năng lực đã được chọn, khóa phiên bản và ghi rõ nguồn." : "NKSkills has two layers: Solution Skills define the outcome and sequence; Upstream Skills provide selected capabilities with pinned versions and recorded sources."}</p>
      <div class="catalog-index"><a href="#solutions">02 <span>Solution Skills</span></a><a href="#upstreams">{String(upstreams.length).padStart(2, "0")} <span>Upstream Skills</span></a><a href="#method">01 <span>{vi ? "Cách quản lý" : "Versioning model"}</span></a></div>
    </div>
  </div>

  <section class="container catalog-section" id="solutions">
    <div class="catalog-heading"><p class="eyebrow">01 / SOLUTION SKILLS</p><h2>{vi ? "Workflow được đóng gói theo kết quả." : "Workflows packaged around an outcome."}</h2><p>{vi ? "Mỗi Solution Skill có phiên bản riêng, manifest thành phần và tiêu chuẩn kiểm tra. Trạng thái bên dưới phản ánh mức độ xác minh hiện tại." : "Each Solution Skill has its own version, component manifest, and verification criteria. These statuses reflect current evidence."}</p></div>
    <div class="solution-list">
      <article class="catalog-solution"><div><span class="catalog-number">01 / {vi ? "BẢN PHÁT HÀNH KỸ THUẬT" : "TECHNICAL RELEASE"}</span><h3>Codebase onboarding <span>1.1.0</span></h3><p>{vi ? "Dẫn kỹ sư qua hành trình sản phẩm, sơ đồ C1/C2 và dẫn chứng theo file trước khi sửa mã." : "Trace a product journey, C1/C2 views, and file evidence before changing code."}</p><div class="catalog-tags"><span>Codex</span><span>Claude Code</span><span>3 {vi ? "thành phần" : "components"}</span></div></div><a href={solution} aria-label={vi ? "Xem giải pháp codebase onboarding" : "View codebase onboarding solution"}>↗</a></article>
      <article class="catalog-solution candidate"><div><span class="catalog-number">02 / {vi ? "ỨNG VIÊN ĐÁNH GIÁ" : "EVALUATION CANDIDATE"}</span><h3>Problem presentation <span>0.1.0</span></h3><p>{vi ? "Tạo deck HTML và PDF ngoại tuyến để trình bày một vấn đề có dẫn chứng và quyết định cần đưa ra. Chưa qua cổng phát hành thương mại." : "Create an offline HTML and PDF deck around one evidenced problem and decision. Commercial release gate remains open."}</p><div class="catalog-tags"><span>Codex</span><span>Claude Code</span><span>{vi ? "Đang đánh giá" : "In evaluation"}</span></div></div><a href="https://github.com/KhucHieuNghi/agents-skills/blob/main/solutions/problem-presentation.yaml" aria-label={vi ? "Xem manifest problem presentation" : "View problem presentation manifest"}>↗</a></article>
    </div>
  </section>

  <section class="catalog-upstreams" id="upstreams"><div class="container catalog-section">
    <div class="catalog-heading"><p class="eyebrow">02 / UPSTREAM SKILLS</p><h2>{vi ? "Nguồn công khai, phiên bản cụ thể." : "Public sources, precise revisions."}</h2><p>{vi ? "Danh mục này theo dõi nguồn, commit và giấy phép. Một số skill đang được dùng để biên soạn website; việc xuất hiện ở đây không có nghĩa là đã nằm trong Solution Skill phát hành." : "This catalog tracks source, commit, and license. Some skills help author this website; listing one here does not make it part of a released Solution Skill."}</p></div>
    <div class="upstream-table" role="list">
      {upstreams.map((item) => <article class="upstream-row" role="listitem"><div class="upstream-name"><strong>{item.id}</strong><span>{authoring.has(item.id) ? (vi ? "Công cụ biên soạn" : "Authoring tool") : (vi ? "Nguồn theo dõi" : "Tracked source")}</span></div><div class="upstream-topics">{item.topics.slice(0, 2).map((topic) => <span>{topic}</span>)}</div><div class="upstream-revision"><span>{item.license}</span><code>{item.revision.slice(0, 10)}</code></div><a href={`${item.repository.replace(/\.git$/, "")}/tree/${item.revision}/${item.skillPath}`} aria-label={`${item.id} source`}>↗</a></article>)}
    </div>
    <p class="catalog-source-note">{vi ? "Nguồn dữ liệu: catalog.yaml trong repository. Commit đầy đủ, checksum, quy tắc ghi nguồn và thay đổi cục bộ nằm trong file này." : "Source: repository catalog.yaml. Full commits, checksums, attribution, and local modifications are recorded there."} <a href="https://github.com/KhucHieuNghi/agents-skills/blob/main/catalog.yaml">catalog.yaml ↗</a></p>
  </div></section>

  <section class="container catalog-section catalog-method" id="method"><div><p class="eyebrow">03 / {vi ? "QUẢN LÝ PHIÊN BẢN" : "VERSIONING"}</p><h2>{vi ? "Cập nhật có kiểm soát." : "Updates, with a review step."}</h2></div><div><p>{vi ? "Chúng tôi theo dõi commit mới của upstream. Khi có thay đổi, đó là một ứng viên để kiểm tra giấy phép, nội dung và tác động. Solution Skill chỉ thay đổi khi ra phiên bản riêng cùng manifest và bằng chứng kiểm tra mới." : "We monitor upstream commits. A new commit becomes a candidate for license, content, and impact review. A Solution Skill changes only through its own versioned manifest and fresh verification evidence."}</p><a class="text-link" href="https://github.com/KhucHieuNghi/agents-skills/blob/main/docs/product-model.md">{vi ? "Đọc mô hình sản phẩm →" : "Read the product model →"}</a></div></section>
</Base>
